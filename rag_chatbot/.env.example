GOOGLE_API_KEY=your-google-ai-studio-key-here
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX_NAME=ask-your-docs

# Optional overrides
# NOTE: gemini-embedding-001 outputs 3072-dim vectors by default -- your Pinecone
# index must be created with dimension=3072 (metric=cosine) to match.
EMBEDDING_MODEL=models/gemini-embedding-001
CHAT_MODEL=gemini-3.5-flash-lite
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
